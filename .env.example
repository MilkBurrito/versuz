# Versuz environment.
#
# LOCAL DEMO (default, zero setup): leave everything unset — the app runs on
# an in-browser seeded save, no network, no login.
#
# CLOUD MODE (the live site): set all three and users sign in with
# email + password; progress lives in Supabase and follows the account.
# On Vercel, set these as project Environment Variables.

# NEXT_PUBLIC_DATA_BACKEND=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# TRANSLATION PROXIES (Phase 2 — server-side ONLY, never NEXT_PUBLIC):
# api.bible key → enables NLT / NIV / NASB through /api/verse
# BIBLE_API_KEY=your-api-bible-key
# Crossway ESV key → enables ESV (non-commercial terms; see docs/translations.md)
# ESV_API_KEY=your-esv-key
